            dialog.add_buttons(
                Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                Gtk.STOCK_OPEN, Gtk.ResponseType.OK
            )

            filter_audio = Gtk.FileFilter()
            filter_audio.set_name("File Audio (*.wav, *.mp3, *.ogg, *.flac, *.m4a)")
            for ext in ["*.wav", "*.mp3", "*.ogg", "*.flac", "*.m4a", "*.aac"]:
                filter_audio.add_pattern(ext)
            dialog.add_filter(filter_audio)

            if dialog.run() == Gtk.ResponseType.OK:
                self.selected_audio_file = dialog.get_filename()
                base = os.path.basename(self.selected_audio_file)
