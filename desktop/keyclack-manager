def slugify(text):
    text = text.lower()
    text = re.sub(r'[^a-z0-9]+', '-', text)
    return text.strip('-') or 'custom-switch'

def clear_soundpack_cache():
    try:
        if os.path.exists(CACHE_FILE):
            os.remove(CACHE_FILE)
            print("Soundpack cache cleared.")
    except Exception as e:
        print(f"Error clearing cache: {e}")

def restart_keyclack():
    subprocess.run(["pkill", "-f", "mechvibes"], check=False)
    clear_soundpack_cache()
    keyclack_autovol.start_daemon()
    env = os.environ.copy()
    env["DISPLAY"] = env.get("DISPLAY", ":0")
    subprocess.Popen([APP_EXEC], env=env, start_new_session=True)

def get_installed_packs():
    installed = {}
    if not os.path.exists(SOUNDPACKS_DIR):
        return installed
    for item in sorted(os.listdir(SOUNDPACKS_DIR)):
        item_path = os.path.join(SOUNDPACKS_DIR, item)
        if os.path.isdir(item_path):
            cfg_path = os.path.join(item_path, "config.json")
            if os.path.exists(cfg_path):
                try:
                    with open(cfg_path, "r", encoding="utf-8") as f:
                        cfg = json.load(f)
                    installed[item] = {
                        "name": cfg.get("name", item),
                        "author": cfg.get("author", "Unknown"),
                        "description": cfg.get("description", ""),
                        "folder": item,
                        "path": item_path
                    }
                except Exception:
                    installed[item] = {"name": item, "author": "Unknown", "folder": item, "path": item_path}
    return installed

def download_and_extract_pack(pack_id, pack_name, callback=None):
    slug = slugify(pack_name)
    target_dir = os.path.join(SOUNDPACKS_DIR, slug)
    url = f"https://mechvibes.com/api/sound-packs/{pack_id}/download"

    if callback:
        callback(f"Mengunduh {pack_name}...", 0.2)

    req = urllib.request.Request(url, headers={"User-Agent": "KeyClack/1.0"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = resp.read()

    if callback:
        callback("Mengekstrak file...", 0.6)

    z = zipfile.ZipFile(io.BytesIO(data))
    names = z.namelist()
    config_entry = next((n for n in names if os.path.basename(n) == "config.json"), None)
    prefix = ""
    if config_entry and "/" in config_entry:
        prefix = config_entry.rsplit("/", 1)[0] + "/"

    os.makedirs(target_dir, exist_ok=True)
    for member in z.infolist():
        if member.is_dir():
            continue
        rel_name = member.filename[len(prefix):] if (prefix and member.filename.startswith(prefix)) else os.path.basename(member.filename)
        if not rel_name:
            continue
        out_path = os.path.join(target_dir, rel_name)
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        with z.open(member) as src, open(out_path, "wb") as dst:
            dst.write(src.read())

    clear_soundpack_cache()
    if callback:
        callback("Selesai dipasang!", 1.0)
    return target_dir

def create_soundpack_from_audio(audio_path, pack_name, random_pitch=True, space_thock=True, callback=None):
    if not os.path.exists(audio_path):
        raise FileNotFoundError(f"File audio tidak ditemukan: {audio_path}")

    slug = slugify(pack_name)
    target_dir = os.path.join(SOUNDPACKS_DIR, slug)
    os.makedirs(target_dir, exist_ok=True)

    target_audio = os.path.join(target_dir, "sound.wav")

    if callback:
        callback("Mengonversi audio ke format WAV kualitas tinggi...", 0.3)

    # Convert audio with ffmpeg to 44.1kHz stereo WAV
    cmd = [
        "ffmpeg", "-y", "-i", audio_path,
        "-vn", "-ar", "44100", "-ac", "2",
        "-c:a", "pcm_s16le", target_audio
    ]
    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if res.returncode != 0:
        raise RuntimeError(f"Gagal mengonversi file audio: {res.stderr.decode()}")

    if callback:
        callback("Menganalisis durasi suara...", 0.6)

    # Get duration with ffprobe
    probe_cmd = [
        "ffprobe", "-v", "error", "-show_entries", "format=duration",
        "-of", "default=noprint_wrappers=1:nokey=1", target_audio
    ]
    p_res = subprocess.run(probe_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    duration_sec = float(p_res.stdout.decode().strip() or "0.35")
    duration_ms = min(duration_sec * 1000.0, 800.0) # Cap at 800ms for crisp keystroke response

    if callback:
        callback("Membuat konfigurasi tombol keyboard...", 0.8)

    definitions = {}
    for key in ALL_KEYS:
        definitions[key] = {
            "timing": [[0.0, round(duration_ms, 2)]]
        }

    config = {
        "name": pack_name,
        "author": "Custom",
        "description": f"Custom switch dibuat dari {os.path.basename(audio_path)}",
        "version": "1.0",
        "config_version": 2,
        "audio_file": "sound.wav",
        "definition_method": "single",
        "options": {
            "random_pitch": bool(random_pitch),
            "recommended_volume": 1.0
        },
        "definitions": definitions
    }

    config_path = os.path.join(target_dir, "config.json")
    with open(config_path, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2)

    clear_soundpack_cache()
    if callback:
        callback("Soundpack berhasil dibuat dan dipasang!", 1.0)
    return target_dir


