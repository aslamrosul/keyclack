                self.update_installed_list()
                restart_keyclack()
                self.show_dialog(
                    "Soundpack Berhasil Dibuat!",
                    f"Soundpack '{name}' telah sukses dibuat dan dipasang ke:\n{dest}\n\nKeyClack telah dimuat ulang. Anda bisa langsung memilih '{name}' di menu dropdown switch KeyClack!"
                )
            except Exception as e:
                self.show_dialog("Gagal Membuat Soundpack", f"Terjadi kesalahan:\n{e}")

        # Tab 3: Installed Packs
        def create_installed_tab(self):
            tab_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            tab_box.set_border_width(12)

            top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            lbl = Gtk.Label(label="Daftar Soundpack yang Terpasang di Komputer Anda:")
            lbl.set_halign(Gtk.Align.START)
            top_bar.pack_start(lbl, True, True, 0)

            btn_refresh = Gtk.Button(label="🔄 Refresh Daftar")
            btn_refresh.connect("clicked", lambda _: self.update_installed_list())
            top_bar.pack_end(btn_refresh, False, False, 0)

            tab_box.pack_start(top_bar, False, False, 0)

            self.installed_store = Gtk.ListStore(str, str, str, str)
            self.installed_tree = Gtk.TreeView(model=self.installed_store)

            r_name = Gtk.CellRendererText()
            r_name.set_property("weight", Pango.Weight.BOLD)
            col_name = Gtk.TreeViewColumn("Nama Soundpack", r_name, text=0)
            col_name.set_min_width(240)
            self.installed_tree.append_column(col_name)

            r_author = Gtk.CellRendererText()
            col_author = Gtk.TreeViewColumn("Pembuat", r_author, text=1)
            col_author.set_min_width(120)
            self.installed_tree.append_column(col_author)

            r_folder = Gtk.CellRendererText()
            col_folder = Gtk.TreeViewColumn("Nama Folder", r_folder, text=2)
            col_folder.set_min_width(200)
            self.installed_tree.append_column(col_folder)

            scrolled = Gtk.ScrolledWindow()
            scrolled.set_vexpand(True)
            scrolled.add(self.installed_tree)
            tab_box.pack_start(scrolled, True, True, 0)

            # Bottom actions
            act_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

            btn_open_selected = Gtk.Button(label="📁 Buka Folder Switch Ini")
            btn_open_selected.connect("clicked", self.on_open_selected_folder)
            act_box.pack_start(btn_open_selected, False, False, 0)

            btn_delete = Gtk.Button(label="🗑️ Hapus Switch Ini")
            btn_delete.connect("clicked", self.on_delete_selected_pack)
            act_box.pack_start(btn_delete, False, False, 0)

            btn_web_editor = Gtk.Button(label="🌐 Buka Sound Pack Editor Web Resmi")
            btn_web_editor.connect("clicked", lambda _: subprocess.Popen(["xdg-open", "https://editor.mechvibes.com/"]))
            act_box.pack_end(btn_web_editor, False, False, 0)

            tab_box.pack_start(act_box, False, False, 0)

            tab_label = Gtk.Label(label="📦 Terpasang")
            self.notebook.append_page(tab_box, tab_label)

            self.update_installed_list()

        def update_installed_list(self):
            self.installed_store.clear()
            installed = get_installed_packs()
            for slug, item in installed.items():
                self.installed_store.append([
                    item.get("name", slug),
                    item.get("author", "Unknown"),
                    slug,
                    item.get("path", "")
                ])

        def on_open_selected_folder(self, btn):
            selection = self.installed_tree.get_selection()
            model, treeiter = selection.get_selected()
            if not treeiter:
                self.show_dialog("Pemberitahuan", "Pilih soundpack yang ingin dibuka foldernya.")
                return
            path = model[treeiter][3]
            subprocess.Popen(["xdg-open", path])

        def on_delete_selected_pack(self, btn):
            selection = self.installed_tree.get_selection()
            model, treeiter = selection.get_selected()
            if not treeiter:
                self.show_dialog("Pemberitahuan", "Pilih soundpack yang ingin dihapus.")
                return
            name = model[treeiter][0]
            path = model[treeiter][3]

            dialog = Gtk.MessageDialog(
                parent=self,
                flags=Gtk.DialogFlags.MODAL,
                type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.YES_NO,
                message_format=f"Apakah Anda yakin ingin menghapus soundpack '{name}'?"
            )
            resp = dialog.run()
            dialog.destroy()
            if resp == Gtk.ResponseType.YES:
                try:
                    shutil.rmtree(path)
                    clear_soundpack_cache()
                    self.update_installed_list()
                    restart_keyclack()
                    self.set_status(f"'{name}' telah dihapus.")
                except Exception as e:
                    self.show_dialog("Gagal Menghapus", f"Error: {e}")

        # Tab 4: Volume Lock (Inverse Auto-Calibration)
        def create_volume_lock_tab(self):
            tab_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            tab_box.set_border_width(18)

            lbl_intro = Gtk.Label()
            lbl_intro.set_markup(
                "<b>Kunci Kenyaringan Suara Keyboard (Auto-Calibrate)</b>\n"
                "Fitur ini memisahkan volume suara keyboard dari volume laptop Anda secara pintar.\n"
                "Ketika Anda menaikkan volume laptop (misal dari 30% ke 80% untuk mendengar video yang lirih),\n"
                "KeyClack secara instan mengecilkan volume dirinya sendiri. Sebaliknya saat laptop dipelankan, KeyClack menaikkannya.\n"
                "<b>Hasilnya:</b> Suara ketikan keyboard selalu di tingkat kenyaringan yang <b>SAMA PERSIS</b>."
            )
            lbl_intro.set_halign(Gtk.Align.START)
            tab_box.pack_start(lbl_intro, False, False, 0)

            # Frame 1: Saklar Kunci Volume
            s_frame = Gtk.Frame(label=" 1. Status Fitur ")
            s_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            s_box.set_border_width(12)
            s_frame.add(s_box)

            lbl_sw = Gtk.Label(label="Kunci Volume Suara Keyboard (Auto-Calibrate):")
            lbl_sw.set_halign(Gtk.Align.START)
            lbl_sw.set_hexpand(True)
            s_box.pack_start(lbl_sw, True, True, 0)

            self.sw_autovol = Gtk.Switch()
            cfg = keyclack_autovol.load_config()
            self.sw_autovol.set_active(cfg.get("enabled", True))
            self.sw_autovol.connect("notify::active", self.on_autovol_toggled)
            s_box.pack_end(self.sw_autovol, False, False, 0)

            tab_box.pack_start(s_frame, False, False, 0)

            # Frame 2: Slider Kenyaringan
            v_frame = Gtk.Frame(label=" 2. Atur Ukuran Suara Keyboard yang Terkunci ")
            v_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            v_box.set_border_width(12)
            v_frame.add(v_box)

            lbl_slider_desc = Gtk.Label(label="Pilih seberapa kencang suara keyboard yang Anda inginkan (Acoustic Output Target):")
            lbl_slider_desc.set_halign(Gtk.Align.START)
            v_box.pack_start(lbl_slider_desc, False, False, 0)

            self.scale_loudness = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 15, 100, 5)
            self.scale_loudness.set_value(cfg.get("target_loudness_pct", 60))
            self.scale_loudness.set_digits(0)
            self.scale_loudness.set_value_pos(Gtk.PositionType.RIGHT)
            self.scale_loudness.add_mark(30, Gtk.PositionType.BOTTOM, "Lembut (30%)")
            self.scale_loudness.add_mark(60, Gtk.PositionType.BOTTOM, "Standar (60%)")
            self.scale_loudness.add_mark(85, Gtk.PositionType.BOTTOM, "Kencang (85%)")
            self.scale_loudness.connect("value-changed", self.on_loudness_changed)
            v_box.pack_start(self.scale_loudness, False, False, 0)

            # Preset buttons
            preset_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            lbl_presets = Gtk.Label(label="Pilihan Cepat:")
            preset_box.pack_start(lbl_presets, False, False, 0)

            for name, val in [("Lembut (35%)", 35), ("Standar (60%)", 60), ("Kencang (85%)", 85)]:
                btn_p = Gtk.Button(label=name)
                btn_p.connect("clicked", lambda _, v=val: self.scale_loudness.set_value(v))
                preset_box.pack_start(btn_p, False, False, 0)

            v_box.pack_start(preset_box, False, False, 4)
            tab_box.pack_start(v_frame, False, False, 0)

            # Frame 3: Live Telemetry
            m_frame = Gtk.Frame(label=" 3. Monitor Kalibrasi Real-Time ")
            m_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            m_box.set_border_width(12)
            m_frame.add(m_box)

            self.lbl_telemetry_master = Gtk.Label()
            self.lbl_telemetry_master.set_halign(Gtk.Align.START)
            m_box.pack_start(self.lbl_telemetry_master, False, False, 0)

            self.lbl_telemetry_keyclack = Gtk.Label()
            self.lbl_telemetry_keyclack.set_halign(Gtk.Align.START)
            m_box.pack_start(self.lbl_telemetry_keyclack, False, False, 0)

            self.lbl_telemetry_status = Gtk.Label()
            self.lbl_telemetry_status.set_halign(Gtk.Align.START)
            m_box.pack_start(self.lbl_telemetry_status, False, False, 0)

            tab_box.pack_start(m_frame, False, False, 0)

            tab_label = Gtk.Label(label="🔊 Kunci Volume")
            self.notebook.append_page(tab_box, tab_label)

            # Start background live monitor update timer
            GLib.timeout_add(1000, self.update_volume_lock_telemetry)
            self.update_volume_lock_telemetry()

        def on_autovol_toggled(self, switch, gparam):
            is_active = switch.get_active()
            cfg = keyclack_autovol.load_config()
            cfg["enabled"] = is_active
            keyclack_autovol.save_config(cfg)
            if is_active:
                keyclack_autovol.start_daemon()
                keyclack_autovol.apply_calibration(cfg)
                self.set_status("Kunci Volume Keyboard AKTIF.")
            else:
                keyclack_autovol.stop_daemon()
                self.set_status("Kunci Volume Keyboard DINONAKTIFKAN.")
            self.update_volume_lock_telemetry()

        def on_loudness_changed(self, scale):
            val = int(scale.get_value())
            cfg = keyclack_autovol.load_config()
            cfg["target_loudness_pct"] = val
            keyclack_autovol.save_config(cfg)
            keyclack_autovol.apply_calibration(cfg)
            self.update_volume_lock_telemetry()

        def update_volume_lock_telemetry(self):
            cfg = keyclack_autovol.load_config()
            master_vol, is_muted = keyclack_autovol.get_master_sink_info()
            pid = keyclack_autovol.is_running()
            target = cfg.get("target_loudness_pct", 60)
            enabled = cfg.get("enabled", True)

            self.lbl_telemetry_master.set_markup(
                f"• <b>Volume Laptop (Master):</b> {master_vol}% {'(MUTED)' if is_muted else ''}"
            )

            if not enabled:
                self.lbl_telemetry_keyclack.set_markup("• <b>Volume KeyClack:</b> Mengikuti volume bawaan laptop")
                self.lbl_telemetry_status.set_markup("• <b>Status:</b> Kunci Volume Nonaktif (Volume keyboard akan naik/turun bersama laptop)")
            elif is_muted:
                self.lbl_telemetry_keyclack.set_markup("• <b>Volume KeyClack:</b> Hening (0%)")
                self.lbl_telemetry_status.set_markup("• <b>Status:</b> Laptop di-mute")
            else:
                calc = int(round((target * 100.0) / master_vol)) if master_vol > 0 else 0
                calc = max(cfg.get("min_pct", 15), min(cfg.get("max_pct", 500), calc))
                self.lbl_telemetry_keyclack.set_markup(
                    f"• <b>Volume KeyClack:</b> {calc}% <i>(Otomatis disesuaikan real-time)</i>"
                )
                self.lbl_telemetry_status.set_markup(
                    f"• <b>Hasil Suara Keyboard:</b> <span color='#16a34a' weight='bold'>TERKUNCI pada {target}%</span> "
                    f"<i>(Daemon aktif: PID {pid})</i>"
                )
            return True

        def on_restart_clicked(self, btn):
            restart_keyclack()
            self.show_dialog("KeyClack Dimuat Ulang", "KeyClack berhasil dimuat ulang dengan daftar suara terbaru.")

        def show_dialog(self, title, message):
            dialog = Gtk.MessageDialog(
                parent=self,
                flags=Gtk.DialogFlags.MODAL,
                type=Gtk.MessageType.INFO,
                buttons=Gtk.ButtonsType.OK,
                message_format=title
            )
            dialog.format_secondary_text(message)
            dialog.run()
            dialog.destroy()

    win = KeyClackManagerWindow(start_tab)
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.notebook.set_current_page(start_tab)
    Gtk.main()


def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ["--help", "-h"]:
            print("Penggunaan: keyclack-manager [perintah]")
            print("Perintah:")
            print("  gui                   Buka antarmuka grafis (default)")
            print("  list                  Tampilkan soundpack yang terpasang")
            print("  create <audio> <nama> Buat soundpack dari file audio")
            print("  download <id> <nama>  Download pack dari Mechvibes")
            print("  lock <10-100>         Atur target persentase kunci volume")
            print("  refresh               Muat ulang cache dan KeyClack")
            print("  open-folder           Buka folder soundpacks di file manager")
            return
        elif arg == "list":
            packs = get_installed_packs()
            print(f"Soundpacks terpasang ({len(packs)}):")
            for slug, item in packs.items():
                print(f"  • {item['name']} ({slug}) oleh {item['author']}")
            return
        elif arg == "refresh":
            restart_keyclack()
            print("KeyClack refreshed!")
            return
        elif arg == "open-folder":
            subprocess.Popen(["xdg-open", SOUNDPACKS_DIR])
            return
        elif arg == "create" and len(sys.argv) >= 4:
            audio = sys.argv[2]
            name = sys.argv[3]
            create_soundpack_from_audio(audio, name)
            print(f"Soundpack '{name}' berhasil dibuat!")
            return
        elif arg == "lock" and len(sys.argv) >= 3:
            keyclack_autovol.main()
            return
        elif arg == "--tab=create":
            run_gui(start_tab=1)
            return
        elif arg == "--tab=installed":
            run_gui(start_tab=2)
            return
        elif arg == "--tab=volume":
            run_gui(start_tab=3)
            return

    run_gui(start_tab=0)

if __name__ == "__main__":
    main()
