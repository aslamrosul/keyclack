        def load_online_packs(self):
            GLib.idle_add(self.spinner.start)
            GLib.idle_add(self.set_status, "Menghubungi katalog Mechvibes...")
            try:
                url = "https://mechvibes.com/api/sound-packs?limit=60&sortBy=downloads&category=keyboard"
                req = urllib.request.Request(url, headers={"User-Agent": "KeyClack/1.0"})
                with urllib.request.urlopen(req, timeout=10) as resp:
                    data = json.loads(resp.read().decode())
                self.online_packs = data.get("packs", [])
                GLib.idle_add(self.update_online_list)
                GLib.idle_add(self.set_status, f"Berhasil memuat {len(self.online_packs)} soundpack dari komunitas.")
            except Exception as e:
                GLib.idle_add(self.set_status, f"Gagal memuat katalog: {e}")
            finally:
                GLib.idle_add(self.spinner.stop)

        def update_online_list(self):
            self.online_store.clear()
            installed = get_installed_packs()
            query = self.search_entry.get_text().lower()

            for pack in self.online_packs:
                name = pack.get("name", "Unknown")
                slug = slugify(name)
                author = pack.get("author", "Unknown")
                dl = f"{pack.get('downloads', 0):,} dl"
                desc = (pack.get("description") or "").replace("\n", " ").strip()
                pid = pack.get("id", "")

                if query and (query not in name.lower() and query not in desc.lower() and query not in author.lower()):
                    continue

                is_installed = slug in installed
                status_text = "✓ Terpasang" if is_installed else "Tersedia"
                self.online_store.append([pid, name, author, dl, desc, status_text, not is_installed])

        def on_search_changed(self, entry):
            self.update_online_list()

        def on_download_selected(self, btn):
            selection = self.online_tree.get_selection()
            model, treeiter = selection.get_selected()
            if not treeiter:
                self.show_dialog("Pemberitahuan", "Silakan pilih salah satu soundpack di tabel terlebih dahulu.")
                return

            pid = model[treeiter][0]
            name = model[treeiter][1]

            self.btn_download.set_sensitive(False)
            self.spinner.start()
            self.set_status(f"Mengunduh {name}...")

            def worker():
                try:
                    download_and_extract_pack(pid, name)
                    GLib.idle_add(self.on_download_complete, name, True, None)
                except Exception as e:
                    GLib.idle_add(self.on_download_complete, name, False, str(e))

            threading.Thread(target=worker, daemon=True).start()

        def on_download_complete(self, name, success, error_msg):
            self.btn_download.set_sensitive(True)
            self.spinner.stop()
            if success:
