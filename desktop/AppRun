#!/usr/bin/env bash
set -eu
HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${HERE}"
export PATH="${HERE}/usr/bin:${PATH}"
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Invalidate soundpack cache so newly installed/custom soundpacks are always discovered
rm -f "${HOME}/.local/share/mechvibes/data/soundpack_cache.json" 2>/dev/null || true

# Start auto-volume calibrator daemon (locks keyboard acoustic loudness)
/home/aslam/.local/bin/keyclack-autovol start 2>/dev/null || true

# Start background companion helper (renamer + hotkey Ctrl+Alt+S)
/home/aslam/.local/bin/keyclack-helper &
HELPER_PID=$!
trap "kill $HELPER_PID 2>/dev/null || true" EXIT

exec "${HERE}/usr/bin/mechvibes" "$@"
